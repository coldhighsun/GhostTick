<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GhostTick</RootNamespace>
    <AssemblyName>GhostTick</AssemblyName>
    <!-- Required by the source-generated LibraryImport P/Invokes in PrecisionWaiter. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <!-- Version is derived automatically from git tags by MinVer (e.g. v1.2.3) -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- 2.0: GhostTickerOptions.Default changed from a field to a property (binary-breaking), on top of the dropped target frameworks. -->
    <MinVerMinimumMajorMinor>2.0</MinVerMinimumMajorMinor>
    <PackageId>GhostTick</PackageId>
    <Authors>coldhighsun</Authors>
    <Description>High-precision timer toolkit for .NET. Delivers TimerEvent values via System.Threading.Channels using a hybrid sleep+spin strategy for sub-millisecond accuracy.</Description>
    <PackageTags>timer;ticker;high-precision;channel;async</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/coldhighsun/GhostTick</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coldhighsun/GhostTick</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GhostTick.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
